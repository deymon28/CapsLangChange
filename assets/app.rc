#include <winver.h>

// Icon 1 is also the executable icon.
1 ICON "icon-active.ico"
2 ICON "icon-paused.ico"
3 ICON "icon-excluded.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CapsLangChange contributors"
            VALUE "FileDescription", "CapsLangChange"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "CapsLangChange"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "CapsLangChange.exe"
            VALUE "ProductName", "CapsLangChange"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
